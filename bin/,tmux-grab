#!/usr/bin/env bash

set -euo pipefail
if [[ "${TRACE-0}" == "1" ]]; then
    set -o xtrace
fi

# Prints a file window spanning 2 lines on either side of hlline, with that
# line bolded.
render_preview() {
    local file=$1 hlline=$2
    local start=$(( hlline > 2 ? hlline - 2 : 1 ))
    local end=$(( hlline + 2 ))
    awk -v start="$start" -v end="$end" -v hlline="$hlline" '
        NR >= start && NR <= end {
            if (NR == hlline) printf "\033[1m%s\033[0m\n", $0
            else print
        }
    ' "$file"
}

main() {
    # tmux doesn't expand #{pane_id} in a new-pane shell-command argument, so
    # the triggering pane is looked up here instead: {last} is the pane that
    # was active in this window right before the new floating pane took over.
    local pane_id
    pane_id=$(tmux display-message -p -t '{last}' '#{pane_id}')

    # -J asks tmux for its own hard-wrap tracking instead of guessing from
    # whitespace: rows the terminal actually wrapped come back pre-joined (a
    # mid-word URL or path split across rows becomes one line), while
    # separate application-printed lines -- even ones butted up against each
    # other with no blank line between, like a two-line prompt -- stay apart.
    # Captured once in natural (oldest-to-newest) order; reused both as the
    # preview's context source and, reversed below, for token extraction.
    local pane_text
    pane_text=$(tmux capture-pane -p -J -S - -t "$pane_id")
    [[ -n "$pane_text" ]] || exit 0

    # Saved to a file so the preview subprocess -- a separate invocation of
    # this script, spawned by fzf once per highlighted item -- can look up
    # context for that item without re-capturing the pane itself.
    local pane_file
    pane_file=$(mktemp)
    trap 'rm -f "$pane_file"' EXIT
    printf '%s\n' "$pane_text" >"$pane_file"
    export PANE_GRAB_FILE="$pane_file"

    # tail -r reverses line order so the most recent scrollback surfaces
    # first in the fzf list, while keeping left-to-right token order within
    # each line.
    local pane_text_reversed
    pane_text_reversed=$(tail -r <<<"$pane_text")

    # Three passes, feeding a first-seen dedup so exact repeats collapse.
    # Whitespace-delimited tokens first (so "foo/bar:baz" is a candidate,
    # and a hard-wrapped URL or path -- one line now, courtesy of -J --
    # comes through whole); then parenthesized spans with the parens
    # stripped (so "(utils.rb:42)" yields "utils.rb:42", and a parenthetical
    # phrase survives as one candidate instead of shattering at its inner
    # spaces); then punctuation-split sub-tokens (so "foo", "bar", "baz" are
    # too). A final pair of filters drops any candidate carrying a raw
    # control byte -- stray escape-sequence remnants, bells, and the like --
    # and any candidate with no ASCII in it at all, like a bare prompt glyph
    # or box-drawing character, since those are never what you meant to
    # copy. LC_ALL=C makes the ASCII-range check byte-exact regardless of
    # the caller's locale.
    local tokens
    tokens=$(
        {
            printf '%s\n' "$pane_text_reversed" | grep --only-matching --extended-regexp '\S+' || true
            printf '%s\n' "$pane_text_reversed" | awk '{
                line = $0
                while (match(line, /\([^()]*\)/)) {
                    if (RLENGTH > 2) print substr(line, RSTART + 1, RLENGTH - 2)
                    line = substr(line, RSTART + RLENGTH)
                }
            }'
            printf '%s\n' "$pane_text_reversed" | grep --only-matching --extended-regexp '[[:alnum:]_]+' || true
        } | awk '!seen[$0]++' | grep -Ev '[[:cntrl:]]' | LC_ALL=C grep -E '[ -~]' || true
    )
    [[ -n "$tokens" ]] || exit 0

    # Float via fzf's own tmux popup, unless the caller already gave us a
    # floating container (e.g. a tmux binding running this in a floating
    # pane), where --tmux would open a redundant, conflicting nested popup.
    # FZF_DEFAULT_OPTS (.zshrc) carries its own --tmux default too, so it's
    # cleared here — otherwise it fires regardless of our own --tmux flag.
    local tmux_opts=(--tmux "80%,60%")
    [[ -n "${IN_TMUX_FLOAT:-}" ]] && tmux_opts=()

    # --expect reports which key completed the selection: it's the first
    # line of output, empty unless ctrl-y/ctrl-o was the trigger, with the
    # selected token on the following line.
    local result
    # macOS ships bash 3.2 (last GPLv2 release); under set -u, "${arr[@]}"
    # on an empty array throws "unbound variable" there (fixed in bash 4.4).
    # The +"${arr[@]}" form works around it for both empty and populated arrays.
    result=$(printf '%s\n' "$tokens" | FZF_DEFAULT_OPTS='' fzf --no-multi --select-1 --no-margin --no-padding \
        "${tmux_opts[@]+"${tmux_opts[@]}"}" \
        --layout reverse \
        --height 100% \
        --highlight-line --info inline-right \
        --header 'enter: insert  ctrl-y: copy  ctrl-o: open' --header-first \
        --expect ctrl-y,ctrl-o \
        --preview "\"$0\" __preview__ {}" \
        --border-label ' grab ') || exit 0
    [[ -n "$result" ]] || exit 0

    local key selection
    key=$(head -n1 <<<"$result")
    selection=$(tail -n +2 <<<"$result")
    [[ -n "$selection" ]] || exit 0

    case "$key" in
        ctrl-y)
            printf '%s' "$selection" | pbcopy
            tmux display-message 'Copied to clipboard'
            ;;
        ctrl-o)
            open -- "$selection"
            ;;
        *)
            tmux send-keys -l -t "$pane_id" -- "$selection"
            ;;
    esac
}

# Renders the preview pane for the item currently highlighted in fzf: the
# 2 lines of scrollback on either side of that item's most recent occurrence,
# with the match itself bolded. Invoked as a fresh instance of this script
# (via the --preview flag above), so it reads the captured pane text from the
# file path the main invocation exported, rather than recapturing.
preview_mode() {
    local token=${1:-}
    local file=${PANE_GRAB_FILE:-}
    if [[ -z "$token" || -z "$file" || ! -f "$file" ]]; then
        echo '(no preview available)'
        return
    fi

    # Every candidate, including a hard-wrapped string -J already joined,
    # appears verbatim on some line; grep keeps natural top-to-bottom order,
    # so the last match is the occurrence closest to "now".
    local line
    line=$(grep -Fn -- "$token" "$file" | tail -n1 | cut -d: -f1) || true
    if [[ -n "$line" ]]; then
        render_preview "$file" "$line"
        return
    fi

    echo '(not found in scrollback)'
}

if [[ "${1:-}" == "__preview__" ]]; then
    preview_mode "${2:-}"
    exit 0
fi

main "$@"
