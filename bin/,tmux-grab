#!/usr/bin/env bash

set -euo pipefail
if [[ "${TRACE-0}" == "1" ]]; then
    set -o xtrace
fi

# Shared awk source, concatenated ahead of a caller-supplied emit()/END.
# joinable() encodes the wrap heuristic: two physical lines belong to the
# same logical string only when neither side shows a deliberate break --
# the left line must not end in whitespace and the right must not begin
# with it (a padded or indented boundary means the newline was intentional,
# not a hard terminal wrap). Empty lines fail both tests, so a blank line --
# two newlines, not "only a newline in between" -- always breaks a run.
# walk_runs() reports each maximal chain of 2+ such lines via emit(start,end).
# shellcheck disable=SC2016  # $0 et al. are awk fields, not shell expansions.
RUNS_AWK='
function joinable(a, b) {
    return (a != "" && b != "" && a !~ /[[:space:]]$/ && b !~ /^[[:space:]]/)
}
function walk_runs(   i, j) {
    i = 1
    while (i <= NR) {
        j = i
        while (j < NR && joinable(lines[j], lines[j+1])) j++
        if (j > i) emit(i, j)
        i = (j > i) ? j + 1 : i + 1
    }
}
{ lines[NR] = $0 }
'

# Emits one candidate per wrap-joined run, newest (bottom-most) run first to
# match the reversed token passes below. Each run yields its no-separator
# concatenation plus every member line individually, so both the
# reconstructed string and its pieces stay grabbable.
combined_candidates() {
    awk "$RUNS_AWK"'
    function emit(s, e) { runs_start[++runs_n] = s; runs_end[runs_n] = e }
    END {
        walk_runs()
        for (r = runs_n; r >= 1; r--) {
            joined = ""
            for (k = runs_start[r]; k <= runs_end[r]; k++) joined = joined lines[k]
            print joined
            for (k = runs_start[r]; k <= runs_end[r]; k++) print lines[k]
        }
    }
    ' <<<"$1"
}

# Locates the run whose concatenation equals a combined candidate, so the
# preview can bold its span. Prints "start end" (1-based line numbers) of the
# last such run -- the one closest to now -- or nothing. TOKEN rides in via
# the environment to dodge awk -v backslash processing on URLs and paths.
find_run_range() {
    local token=$1 file=$2
    TOKEN="$token" awk "$RUNS_AWK"'
    function emit(s, e,   k, joined) {
        joined = ""
        for (k = s; k <= e; k++) joined = joined lines[k]
        if (joined == ENVIRON["TOKEN"]) { best_start = s; best_end = e }
    }
    END {
        walk_runs()
        if (best_start > 0) print best_start, best_end
    }
    ' "$file"
}

# Prints a file window spanning 2 lines on either side of [hlstart, hlend],
# with that inclusive range bolded (a single line for plain tokens, a span
# for combined candidates).
render_preview() {
    local file=$1 hlstart=$2 hlend=$3
    local start=$(( hlstart > 2 ? hlstart - 2 : 1 ))
    local end=$(( hlend + 2 ))
    awk -v start="$start" -v end="$end" -v hlstart="$hlstart" -v hlend="$hlend" '
        NR >= start && NR <= end {
            if (NR >= hlstart && NR <= hlend) printf "\033[1m%s\033[0m\n", $0
            else print
        }
    ' "$file"
}

main() {
    # tmux doesn't expand #{pane_id} in a new-pane shell-command argument, so
    # the triggering pane is looked up here instead: {last} is the pane that
    # was active in this window right before the new floating pane took over.
    local pane_id
    pane_id=$(tmux display-message -p -t '{last}' '#{pane_id}')

    # Captured once in natural (oldest-to-newest) order; reused both as the
    # preview's context source and, reversed below, for token extraction.
    local pane_text
    pane_text=$(tmux capture-pane -p -S - -t "$pane_id")
    [[ -n "$pane_text" ]] || exit 0

    # Saved to a file so the preview subprocess -- a separate invocation of
    # this script, spawned by fzf once per highlighted item -- can look up
    # context for that item without re-capturing the pane itself.
    local pane_file
    pane_file=$(mktemp)
    trap 'rm -f "$pane_file"' EXIT
    printf '%s\n' "$pane_text" >"$pane_file"
    export PANE_GRAB_FILE="$pane_file"

    # tail -r reverses line order so the most recent scrollback surfaces
    # first in the fzf list, while keeping left-to-right token order within
    # each line.
    local pane_text_reversed
    pane_text_reversed=$(tail -r <<<"$pane_text")

    # Four passes, feeding a first-seen dedup so exact repeats collapse.
    # Wrap-joined runs come first (natural order, so it reads the unreversed
    # capture) to surface reconstructed strings at the top; then
    # whitespace-delimited tokens (so "foo/bar:baz" is a candidate); then
    # parenthesized spans with the parens stripped (so "(utils.rb:42)"
    # yields "utils.rb:42", and a parenthetical phrase survives as one
    # candidate instead of shattering at its inner spaces); then
    # punctuation-split sub-tokens (so "foo", "bar", "baz" are too). A final
    # filter drops any candidate carrying a raw control byte -- stray escape-
    # sequence remnants, bells, and the like -- so only real text reaches fzf.
    local tokens
    tokens=$(
        {
            combined_candidates "$pane_text"
            printf '%s\n' "$pane_text_reversed" | grep --only-matching --extended-regexp '\S+' || true
            printf '%s\n' "$pane_text_reversed" | awk '{
                line = $0
                while (match(line, /\([^()]*\)/)) {
                    if (RLENGTH > 2) print substr(line, RSTART + 1, RLENGTH - 2)
                    line = substr(line, RSTART + RLENGTH)
                }
            }'
            printf '%s\n' "$pane_text_reversed" | grep --only-matching --extended-regexp '[[:alnum:]_]+' || true
        } | awk '!seen[$0]++' | grep -Ev '[[:cntrl:]]' || true
    )
    [[ -n "$tokens" ]] || exit 0

    # Float via fzf's own tmux popup, unless the caller already gave us a
    # floating container (e.g. a tmux binding running this in a floating
    # pane), where --tmux would open a redundant, conflicting nested popup.
    # FZF_DEFAULT_OPTS (.zshrc) carries its own --tmux default too, so it's
    # cleared here — otherwise it fires regardless of our own --tmux flag.
    local tmux_opts=(--tmux "80%,60%")
    [[ -n "${IN_TMUX_FLOAT:-}" ]] && tmux_opts=()

    # --expect reports which key completed the selection: it's the first
    # line of output, empty unless ctrl-y/ctrl-o was the trigger, with the
    # selected token on the following line.
    local result
    # macOS ships bash 3.2 (last GPLv2 release); under set -u, "${arr[@]}"
    # on an empty array throws "unbound variable" there (fixed in bash 4.4).
    # The +"${arr[@]}" form works around it for both empty and populated arrays.
    result=$(printf '%s\n' "$tokens" | FZF_DEFAULT_OPTS='' fzf --no-multi --select-1 --no-margin --no-padding \
        "${tmux_opts[@]+"${tmux_opts[@]}"}" \
        --layout reverse \
        --height 100% \
        --highlight-line --info inline-right \
        --header 'enter: insert  ctrl-y: copy  ctrl-o: open' --header-first \
        --expect ctrl-y,ctrl-o \
        --preview "\"$0\" __preview__ {}" \
        --border-label ' grab ') || exit 0
    [[ -n "$result" ]] || exit 0

    local key selection
    key=$(head -n1 <<<"$result")
    selection=$(tail -n +2 <<<"$result")
    [[ -n "$selection" ]] || exit 0

    case "$key" in
        ctrl-y)
            printf '%s' "$selection" | pbcopy
            tmux display-message 'Copied to clipboard'
            ;;
        ctrl-o)
            open -- "$selection"
            ;;
        *)
            tmux send-keys -l -t "$pane_id" -- "$selection"
            ;;
    esac
}

# Renders the preview pane for the item currently highlighted in fzf: the
# 2 lines of scrollback on either side of that item's most recent occurrence,
# with the match itself bolded. Invoked as a fresh instance of this script
# (via the --preview flag above), so it reads the captured pane text from the
# file path the main invocation exported, rather than recapturing.
preview_mode() {
    local token=${1:-}
    local file=${PANE_GRAB_FILE:-}
    if [[ -z "$token" || -z "$file" || ! -f "$file" ]]; then
        echo '(no preview available)'
        return
    fi

    # A plain token, a substring of a line, or an individual member line of a
    # run all appear verbatim on some line; grep keeps natural top-to-bottom
    # order, so the last match is the occurrence closest to "now".
    local line
    line=$(grep -Fn -- "$token" "$file" | tail -n1 | cut -d: -f1) || true
    if [[ -n "$line" ]]; then
        render_preview "$file" "$line" "$line"
        return
    fi

    # A combined candidate exists only as the concatenation of consecutive
    # lines, never verbatim, so fall back to locating its run and bolding the
    # whole span.
    local range
    range=$(find_run_range "$token" "$file") || true
    if [[ -n "$range" ]]; then
        render_preview "$file" "${range% *}" "${range#* }"
        return
    fi

    echo '(not found in scrollback)'
}

if [[ "${1:-}" == "__preview__" ]]; then
    preview_mode "${2:-}"
    exit 0
fi

main "$@"
