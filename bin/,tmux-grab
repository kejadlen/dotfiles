#!/usr/bin/env bash

set -euo pipefail
if [[ "${TRACE-0}" == "1" ]]; then
    set -o xtrace
fi

main() {
    # tmux doesn't expand #{pane_id} in a new-pane shell-command argument, so
    # the triggering pane is looked up here instead: {last} is the pane that
    # was active in this window right before the new floating pane took over.
    local pane_id
    pane_id=$(tmux display-message -p -t '{last}' '#{pane_id}')

    # Captured once in natural (oldest-to-newest) order; reused both as the
    # preview's context source and, reversed below, for token extraction.
    local pane_text
    pane_text=$(tmux capture-pane -p -S - -t "$pane_id")
    [[ -n "$pane_text" ]] || exit 0

    # Saved to a file so the preview subprocess -- a separate invocation of
    # this script, spawned by fzf once per highlighted item -- can look up
    # context for that item without re-capturing the pane itself.
    local pane_file
    pane_file=$(mktemp)
    trap 'rm -f "$pane_file"' EXIT
    printf '%s\n' "$pane_text" >"$pane_file"
    export PANE_GRAB_FILE="$pane_file"

    # tail -r reverses line order so the most recent scrollback surfaces
    # first in the fzf list, while keeping left-to-right token order within
    # each line.
    local pane_text_reversed
    pane_text_reversed=$(tail -r <<<"$pane_text")

    # Two passes: whitespace-delimited tokens first (so "foo/bar:baz" is a
    # candidate), then punctuation-split sub-tokens (so "foo", "bar", "baz"
    # are too). Dedup preserves first-seen order, so exact repeats collapse.
    local tokens
    tokens=$(
        {
            printf '%s\n' "$pane_text_reversed" | grep --only-matching --extended-regexp '\S+' || true
            printf '%s\n' "$pane_text_reversed" | grep --only-matching --extended-regexp '[[:alnum:]_]+' || true
        } | awk '!seen[$0]++'
    )
    [[ -n "$tokens" ]] || exit 0

    # Float via fzf's own tmux popup, unless the caller already gave us a
    # floating container (e.g. a tmux binding running this in a floating
    # pane), where --tmux would open a redundant, conflicting nested popup.
    # FZF_DEFAULT_OPTS (.zshrc) carries its own --tmux default too, so it's
    # cleared here — otherwise it fires regardless of our own --tmux flag.
    local tmux_opts=(--tmux "80%,60%")
    [[ -n "${IN_TMUX_FLOAT:-}" ]] && tmux_opts=()

    # --expect reports which key completed the selection: it's the first
    # line of output, empty unless ctrl-y/ctrl-o was the trigger, with the
    # selected token on the following line.
    local result
    # macOS ships bash 3.2 (last GPLv2 release); under set -u, "${arr[@]}"
    # on an empty array throws "unbound variable" there (fixed in bash 4.4).
    # The +"${arr[@]}" form works around it for both empty and populated arrays.
    result=$(printf '%s\n' "$tokens" | FZF_DEFAULT_OPTS='' fzf --no-multi --select-1 --no-margin --no-padding \
        "${tmux_opts[@]+"${tmux_opts[@]}"}" \
        --layout reverse \
        --height 100% \
        --highlight-line --info inline-right \
        --header 'enter: insert  ctrl-y: copy  ctrl-o: open' --header-first \
        --expect ctrl-y,ctrl-o \
        --preview "\"$0\" __preview__ {}" \
        --border-label ' grab ') || exit 0
    [[ -n "$result" ]] || exit 0

    local key selection
    key=$(head -n1 <<<"$result")
    selection=$(tail -n +2 <<<"$result")
    [[ -n "$selection" ]] || exit 0

    case "$key" in
        ctrl-y)
            printf '%s' "$selection" | pbcopy
            tmux display-message 'Copied to clipboard'
            ;;
        ctrl-o)
            open -- "$selection"
            ;;
        *)
            tmux send-keys -l -t "$pane_id" -- "$selection"
            ;;
    esac
}

# Renders the preview pane for the item currently highlighted in fzf: the
# 2 lines of scrollback on either side of that item's most recent occurrence,
# with the matching line itself bolded. Invoked as a fresh instance of this
# script (via the --preview flag above), so it reads the captured pane text
# from the file path the main invocation exported, rather than recapturing.
preview_mode() {
    local token=${1:-}
    local file=${PANE_GRAB_FILE:-}
    if [[ -z "$token" || -z "$file" || ! -f "$file" ]]; then
        echo '(no preview available)'
        return
    fi

    # grep preserves the file's natural top-to-bottom order, so the last
    # match is the occurrence closest to "now" in the scrollback.
    local line
    line=$(grep -Fn -- "$token" "$file" | tail -n1 | cut -d: -f1) || true
    if [[ -z "$line" ]]; then
        echo '(not found in scrollback)'
        return
    fi

    local start=$(( line > 2 ? line - 2 : 1 ))
    local end=$(( line + 2 ))
    awk -v start="$start" -v end="$end" -v hl="$line" '
        NR >= start && NR <= end {
            if (NR == hl) printf "\033[1m%s\033[0m\n", $0
            else print
        }
    ' "$file"
}

if [[ "${1:-}" == "__preview__" ]]; then
    preview_mode "${2:-}"
    exit 0
fi

main "$@"
