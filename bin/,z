#!/usr/bin/env bash

set -euo pipefail
if [[ "${TRACE-0}" == "1" ]]; then
    set -o xtrace
fi

main() {
    # Float via fzf's own tmux popup, unless the caller already gave us a
    # floating container (e.g. a tmux binding running this in a floating pane),
    # where --tmux would open a redundant popup on top.
    local tmux_opts=(--tmux "80%,60%")
    [[ -n "${IN_TMUX_FLOAT:-}" ]] && tmux_opts=()

    local dir
    # ${arr[@]+"${arr[@]}"} splices the array only when it has elements. A bare
    # "${tmux_opts[@]}" would abort under `set -u` on the empty (IN_TMUX_FLOAT)
    # path, because macOS bash 3.2 counts an empty array as an unbound variable.
    dir=$(zoxide query -l "$@" | fzf --no-multi --select-1 --no-margin --no-padding \
        ${tmux_opts[@]+"${tmux_opts[@]}"} \
        --height 100% \
        --highlight-line --info inline-right \
        --border-label ' zoxide ' \
        --preview 'eza --tree --level=2 --color=always {}' \
        --bind 'ctrl-/:change-preview-window(down|hidden|)') || exit 0

    local name
    name=$(basename "$dir")

    tmux new-window -n "$name" -c "$dir"
}

main "$@"
