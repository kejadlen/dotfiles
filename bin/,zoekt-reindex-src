#!/usr/bin/env bash

set -euo pipefail
if [[ "${TRACE-0}" == "1" ]]; then
    set -o xtrace
fi

# Index every git repo under a root (default ~/src) into the shared
# zoekt index. Only the outermost repo in any nesting is indexed —
# nested repos are almost always vendored or cached content (plugin
# caches, .direnv bundler gems, .build checkouts) that the parent's
# git tracking already excludes, so indexing them separately just
# pollutes results with duplicates.
#
# zoekt-git-index is incremental by default, so re-running only
# touches repos that changed since the last pass.

readonly ROOT="${1:-$HOME/src}"
readonly INDEX_DIR="${ZOEKT_INDEX_DIR:-$HOME/.zoekt}"

# Extended regex of paths to skip even when they are the outermost
# repo, such as backup copies and vendored source trees.
readonly EXCLUDE_RE="${ZOEKT_EXCLUDE_RE-}"

exclude() {
    if [[ -n "$EXCLUDE_RE" ]]; then
        grep --invert-match --extended-regexp "$EXCLUDE_RE"
    else
        cat
    fi
}

main() {
    mkdir -p "$INDEX_DIR"

    # Collect outermost repos: sort the repo list, then keep a path
    # only when it is not nested under any already-kept root. The
    # explicit all-roots check (not just the previous line) is
    # required — a sibling like `app.dev.bin` sorts between
    # `app` and `app/.direnv/...` because '.' < '/',
    # which would let nested repos slip through a prev-only check.
    # The trailing `|| true` is load-bearing: find exits 1 when it
    # hits an unreadable directory under ROOT (the 2>/dev/null hides
    # the message, not the exit code), and under `set -o pipefail`
    # that would fail the whole command substitution and trip set -e.
    local repos
    repos="$(
        find "$ROOT" -type d -name .git -prune 2>/dev/null \
            | while read -r gitdir; do dirname "$gitdir"; done \
            | exclude \
            | sort \
            | awk '{
                nested=0
                for (i=0;i<n;i++) if (index($0"/", roots[i]"/")==1) { nested=1; break }
                if (!nested) { roots[n++]=$0; print }
              }' || true
    )"

    local total failed=0 indexed=0
    total="$(printf '%s\n' "$repos" | grep --count . || true)"
    echo "Indexing $total repos under $ROOT into $INDEX_DIR"

    while IFS= read -r repo; do
        [[ -z "$repo" ]] && continue
        # zoekt-git-index aborts on a repo with no commits (no HEAD);
        # skip those rather than counting them as failures.
        if ! git -C "$repo" rev-parse --verify --quiet HEAD >/dev/null 2>&1; then
            echo "SKIP (no commits): $repo"
            continue
        fi
        if zoekt-git-index -index "$INDEX_DIR" "$repo" >/dev/null 2>&1; then
            indexed=$((indexed + 1))
        else
            echo "FAILED: $repo"
            failed=$((failed + 1))
        fi
    done <<< "$repos"

    echo "Done: $indexed indexed, $failed failed"
    [[ "$failed" -eq 0 ]]
}

main "$@"
