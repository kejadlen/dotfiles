Include ~/.orbstack/ssh/config
Include config.local

TCPKeepALive yes
ServerAliveInterval 60
ControlMaster auto
ControlPath /tmp/%r@%h:%p
ControlPersist yes

Host *
  VisualHostKey yes

Host 127.0.0.1
  StrictHostKeyChecking no

Host quire
  User quire
  # need to manually set the hostname since the quire
  # container itself doesn't include an SSH server
  HostName imperishable-night
