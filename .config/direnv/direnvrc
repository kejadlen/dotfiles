# https://github.com/direnv/direnv/wiki/ruby#-ruby-install
use_ruby() {
  local version=$1

  # Get version from .ruby-version if not specified
  if [[ -z $version ]] && [[ -f .ruby-version ]]; then
    version=$(cat .ruby-version)
  fi

  # Find matching version (exact or prefix match)
  if [[ -n $version ]] && [[ ! -d $HOME/.rubies/$version ]]; then
    version=$(ls -1 $HOME/.rubies | grep "^$version" | sort -V | tail -1)
  fi

  # Fall back to latest version if still no match
  if [[ -z $version ]]; then
    version=$(ls -1 $HOME/.rubies | sort -V | tail -1)
  fi

  local ruby_root=$HOME/.rubies/$version
  load_prefix "$ruby_root"
  layout_ruby
}

# https://hynek.me/articles/python-virtualenv-redux/#:~:text=Then%2C%20I%20add%20the%20following%20to%20the%20project%E2%80%99s%20%2Eenvrc%3A
use_uv() {
  test -d .venv || uv venv
  source .venv/bin/activate
  uv sync
}
