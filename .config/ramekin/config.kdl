// Machine default profile. Selects the builtin trivial `pi`; agent config
// (AGENTS.md, skills) rides in through the binary allowlist off ~/.pi/agent,
// so nothing needs restating here. `-p claude` for the other builtin.
profile "pi"

// Pi against Amazon Bedrock. Pi selects the provider by flag (no env
// equivalent); the model is left to pi at run time. AWS creds come from an
// SSO profile — fill in the placeholders and `aws sso login` on the host.
// ~/.aws mounts read-only, so an expired SSO token means re-logging in on
// the host rather than a silent in-container refresh.
profile "pi-bedrock" {
  agent "pi"
  args "--provider" "amazon-bedrock"
  env {
    AWS_PROFILE "bedrock-users"
  }
  mounts { "~/.aws" }
}

mounts {
  // Agent config that sits outside the binary allowlist but is still config,
  // kept deliberately. Targets derive from the ~/ source.
  "~/.claude/statusline.sh"
  "~/.claude/output-styles"

  // Pi's settings.json points `skills` here rather than at ~/.pi/agent/skills,
  // but settings.json isn't in the binary allowlist, so pi inside reads only
  // the default dir. Retarget the mount to shadow the (empty) inherited bind.
  "~/.dotfiles/ai/skills" target="/root/.pi/agent/skills"

  // Shadow the workspace's .envrc so repo secrets never reach the agent.
  "/dev/null" target=".envrc"

  // Devlog entries are written from inside the container by the devlog skill,
  // so this rides in writable and persists across sessions.
  "~/.claude/devlog" writable=#true

  // jj is the version control in here, and it carries its own identity and
  // signing config, so it needs nothing from git. ~/.config/git deliberately
  // stays out: its https→ssh rewrites can't be followed (no ssh binary, no
  // keys) and can't be revoked either, since insteadOf only accumulates.
  "~/.config/jj"
  // Writable so jj can record repos it sees.
  "~/.config/jj/repos" writable=#true

  // ranger state and pi's pinch dir don't exist on this machine yet, so both
  // stay inert (skip-if-missing) until something creates them.
  "~/.local/share/ranger" writable=#true
}
