" General Setting
set update.lastchecktime 1670274234332
set configversion 2.0

set editorcmd /opt/homebrew/bin/neovide
set smoothscroll true

" vimperator hint mode
set hintfiltermode vimperator-reflow
set hintchars 1234567890

" open in safari
command safari composite get_current_url | shellescape | !s open -a Safari | tabclose

" only hint search results on DDG
bindurl ^https://duckduckgo.com f hint -Jc [data-testid="result-title-a"]
bindurl ^https://duckduckgo.com F hint -Jbc [data-testid="result-title-a"]

" only hint search results on Kagi
bindurl ^https://kagi.com f hint -Jc [class*="_0_URL"]
bindurl ^https://kagi.com F hint -Jbc [class*="_0_URL"]

bindurl ^https://www.instapaper.com/hello2 f hint -Jc button[type="submit"]

" make d take you to the left (I find it much less confusing)
" bind d composite tabprev; tabclose #
" bind D tabclose

" binds
bind j scrollline 3
bind k scrollline -3
bind <C-n> tabnext
bind <C-p> tabprev
bind gR reader --tab

" Nuke Tridactyl settings on exit (there's a bug if this is done
" in the rc file) so that this is the source of truth.
" https://github.com/tridactyl/tridactyl/issues/1409
bind ZZ composite sanitise tridactyllocal tridactylsync; qall

" ignore modes
autocmd DocStart gisnep.com mode ignore
autocmd DocStart minutecryptic.com mode ignore
autocmd DocStart nytimes.com/crosswords mode ignore

" new reddit is bad
" autocmd DocStart ^http(s?)://www.reddit.com js tri.excmds.urlmodify("-t", "www", "old")

" set auconcreatecontainer true
" https://github.com/tridactyl/tridactyl/issues/951
set autocontainmode relaxed
autocontain amazon\.com Shopping
autocontain bsky\.app Social
autocontain facebook\.com Facebook
autocontain instagram\.com Facebook
autocontain linkedin\.com Social
autocontain youtube\.com Google

" github
" https://docs.github.com/en/get-started/using-github/keyboard-shortcuts
unbindurl github.com s " focus the search bar
" unbindurl github.com t " activate the file finder

" gmail
" https://support.google.com/mail/answer/6594?hl=en
" https://gist.github.com/dradetsky/12b1e1aba4b699240b3e4ff266bdf3c8
" actions
unbindurl mail.google.com x " select conversation
unbindurl mail.google.com e " archive conversation
unbindurl mail.google.com s " toggle star/rotate among superstars
unbindurl mail.google.com ! " report as spam
unbindurl mail.google.com # " delete
" archive conversation and go previous/next
bindurl mail.google.com/mail ] js \
[...']'].forEach(c => document.dispatchEvent(new KeyboardEvent('keydown',{key: c})))
bindurl mail.google.com/mail [ js \
[...'['].forEach(c => document.dispatchEvent(new KeyboardEvent('keydown',{key: c})))
" jumping
bindurl mail.google.com/mail gi js \
[...'gi'].forEach(c => document.dispatchEvent(new KeyboardEvent('keydown',{key: c})))
" navigation
unbindurl mail.google.com j " older conversation
unbindurl mail.google.com k " newer conversation
unbindurl mail.google.com o " open conversation

" linear
unbindurl linear.app s

" youtube
unbindurl youtube.com j " back 10s
unbindurl youtube.com l " forward 10s

unbindurl docs.rs s " focus the search bar

" vim: set filetype=tridactyl
