#!/usr/bin/env bash

# Lists the Claude Code and pi sessions running in Rex, ranked so ,agents and
# the sketchybar agents item can lead with whoever is waiting on a human.
#
# Rex is the source of truth: both agents report their state with OSC 7501, the
# Program Status Protocol (https://www.superlogical.com/rex/docs/build/program-status),
# and Rex keeps the latest report per block. This script only reads it back.
#
# The one thing Rex can't hold is whether a human has looked, so that lives in
# a SQLite table of visits keyed by block. Jumping to a blocked session records
# a visit so the picker moves on to the next one instead of offering the same
# session again, and jumping to a done session shows it as idle from then on.

set -euo pipefail
if [[ "${TRACE-0}" == "1" ]]; then
    set -o xtrace
fi

STATE_DB="${AGENT_STATE_DB:-${XDG_STATE_HOME:-$HOME/.local/state}/agent-state/state.db}"

# busy_timeout must come before journal_mode, which takes an exclusive lock and
# otherwise fails instantly when two writers collide. The .output fencing keeps
# the row an assigning PRAGMA returns off stdout, where it would corrupt `list`.
readonly PRAGMAS="
.output /dev/null
PRAGMA busy_timeout = 3000;
PRAGMA journal_mode = WAL;
PRAGMA synchronous = NORMAL;
.output stdout
"

# records held the hook-written state before Rex took that over.
readonly SCHEMA="
DROP TABLE IF EXISTS panes;
DROP TABLE IF EXISTS records;
CREATE TABLE IF NOT EXISTS visits (
  pane       TEXT PRIMARY KEY,
  visited_at INTEGER NOT NULL
);
"

# Prints one tab-separated row per block whose agent is still the one that
# reported: state, session:window, cwd, updated_at (RFC 3339), message, block,
# app, kind, session. A record outlives the program that wrote it, so a record
# whose owner is neither the foreground process nor one of its ancestors
# belongs to an agent that has exited.
readonly GATHER_LUA='
local function clean(value)
  return (tostring(value or ""):gsub("[\t\n]", " "))
end

local function same(a, b)
  return a and b and a.pid == b.pid and a.name == b.name
end

for _, session in ipairs(rex.call("session.list").sessions or {}) do
  local view = rex.call("session.attach", {session_id = session.session_id}).view
  for index, window in ipairs(view.windows or {}) do
    for _, layer in ipairs(window.layers or {}) do
      for _, block in ipairs(layer.blocks or {}) do
        if block.creator_name == "com.superlogical.terminal" then
          local target = {session_id = session.session_id, block_id = block.block_id}
          target.method = "program_status"
          local record = (rex.call("block.method", target).records or {})[1]
          if record and record.id == nil then
            target.method = "process"
            local process = rex.call("block.method", target)
            local alive = same(record.owner, process.foreground)
            for _, ancestor in ipairs(process.ancestors or {}) do
              alive = alive or same(record.owner, ancestor)
            end
            if alive then
              print(table.concat({
                clean(record.state), clean(session.label .. ":" .. index),
                clean(process.foreground and process.foreground.cwd),
                clean(record.updated_at), clean(record.msg), clean(block.block_id),
                clean(record.effective_app), clean(record.kind), clean(session.session_id),
              }, "\t"))
            end
          end
        end
      end
    end
  end
end
'

# Renders a value as a SQL string literal. SQLite escapes a single quote by
# doubling it, and that is the only escape a single-quoted literal needs.
sql_quote() {
    printf "'%s'" "${1//\'/\'\'}"
}

db() {
    mkdir -p "$(dirname "$STATE_DB")"
    # -batch stops sqlite3 from ever prompting; -noheader keeps output parseable.
    sqlite3 -batch -noheader "$STATE_DB"
}

gather() {
    # The sketchybar poll runs this every few seconds; it must never start a server.
    rex --autostart=false --timeout 3s "do" - <<<"$GATHER_LUA"
}

# Turns gathered rows into a VALUES list for the `live` temp table. Block and
# session ids are checked against Rex's shape before they reach SQL.
live_values() {
    local values=""
    local state label cwd updated message block app kind session
    # Fields are split on US (0x1f) because tab is IFS whitespace: `read`
    # would collapse the empty fields an idle record leaves and shift the rest.
    while IFS=$'\x1f' read -r state label cwd updated message block app kind session; do
        [[ $block =~ ^block:[0-9a-f-]+$ && $session =~ ^session:[0-9a-f-]+$ ]] || continue
        # The spec says to treat an unknown state as idle, and kind only means
        # something on blocked.
        case $state in
            blocked|done|error|idle|working) ;;
            *) state=idle ;;
        esac
        [[ $state == blocked ]] || kind=""
        values+="($(sql_quote "$block"), $(sql_quote "$session"), $(sql_quote "$state"),"
        values+=" $(sql_quote "$label"), $(sql_quote "$cwd"), CAST(strftime('%s', $(sql_quote "$updated")) AS INTEGER),"
        values+=" $(sql_quote "$message"), $(sql_quote "$app"), $(sql_quote "$kind")),"
    done < <(tr '\t' '\037')
    printf '%s' "${values%,}"
}

readonly LIVE_TABLE="
CREATE TEMP TABLE live (
  pane TEXT PRIMARY KEY, session TEXT NOT NULL, state TEXT NOT NULL,
  label TEXT NOT NULL, cwd TEXT NOT NULL, updated_at INTEGER,
  message TEXT NOT NULL, app TEXT NOT NULL, kind TEXT NOT NULL
);
"

# Records that a human jumped to this block. A blocked session sinks below the
# blocked sessions not yet seen; a done or errored one shows as idle, since its
# result is no longer unseen. The block's state is read here rather than
# trusted from the caller, so a stale row can't demote a session that has since
# gone back to working.
cmd_visited() {
    local block=${1:-}
    [[ $block =~ ^block:[0-9a-f-]+$ ]] || return 0

    local values
    values=$(gather | live_values)
    [[ -n $values ]] || return 0

    db <<SQL >/dev/null
$PRAGMAS
$SCHEMA
$LIVE_TABLE
INSERT OR IGNORE INTO live VALUES $values;
-- The WHERE clause is what lets this parse: in an INSERT ... SELECT, SQLite
-- cannot otherwise tell ON CONFLICT from the ON of a join.
INSERT INTO visits (pane, visited_at)
SELECT pane, $(date +%s) FROM live
WHERE pane = $(sql_quote "$block") AND state IN ('blocked', 'done', 'error')
ON CONFLICT(pane) DO UPDATE SET visited_at = excluded.visited_at;
SQL
}

# Emits one tab-separated row per live session:
#   state  session:window  dir  age  message  block  app  kind  session
#
# Ordered by state (blocked, error, done, idle, then working) and, within a
# state, oldest first — the session sitting in it longest is the one most
# likely to have been forgotten.
#
# Except for sessions already visited while blocked, which sink below the rest
# of their state, least recently visited first. Without that, jumping to a
# blocked session and leaving it blocked would land on the same row the next
# time the picker opens, since visiting a block does not change its age.
cmd_list() {
    local values
    values=$(gather | live_values)
    [[ -n $values ]] || return 0

    db <<SQL | format_rows
$PRAGMAS
$SCHEMA
$LIVE_TABLE
INSERT OR IGNORE INTO live VALUES $values;
DELETE FROM visits WHERE pane NOT IN (SELECT pane FROM live);
.mode list
.separator "\t"
-- A visit counts only until the session next reports, so visited_at older than
-- updated_at means it has moved on and belongs back in the age ordering.
WITH ranked AS (
  SELECT l.*,
         v.visited_at IS NOT NULL AND v.visited_at >= COALESCE(l.updated_at, 0) AS seen,
         COALESCE(v.visited_at, 0) AS visited_at
  FROM live l LEFT JOIN visits v ON v.pane = l.pane
), shown AS (
  SELECT *, CASE WHEN seen AND state IN ('done', 'error') THEN 'idle' ELSE state END AS shown_state
  FROM ranked
)
-- max() picks whichever timestamp ranks the row, so demoted blocked rows rotate
-- by visit while every other row sorts by age, in one expression.
SELECT shown_state, label, cwd, COALESCE(updated_at, 0), message, pane, app, kind, session
FROM shown
ORDER BY CASE shown_state WHEN 'blocked' THEN 0 WHEN 'error' THEN 1 WHEN 'done' THEN 2
                          WHEN 'idle' THEN 3 ELSE 4 END,
         CASE WHEN shown_state = 'blocked' AND seen THEN 1 ELSE 0 END,
         max(CASE WHEN seen THEN visited_at ELSE 0 END, COALESCE(updated_at, 0)) ASC;
SQL
}

# Turns the raw SELECT into display columns: cwd to its basename, updated_at to
# a relative age. Done in awk rather than SQL because both are string and clock
# work that SQLite makes awkward, and awk -F'\t' keeps empty fields intact.
format_rows() {
    awk -F'\t' -v now="$(date +%s)" '
        function age(secs) {
            if (secs < 60)   return secs "s"
            if (secs < 3600) return int(secs / 60) "m"
            return int(secs / 3600) "h" int((secs % 3600) / 60) "m"
        }
        {
            n = split($3, parts, "/")
            printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n", $1, $2, parts[n], age(now - $4), $5, $6, $7, $8, $9
        }
    '
}

main() {
    local command=${1:-}
    shift || true

    local tool
    for tool in sqlite3 rex; do
        command -v "$tool" >/dev/null 2>&1 || {
            echo ",agent-state: $tool not found" >&2
            return 1
        }
    done

    case $command in
        list)    cmd_list ;;
        visited) cmd_visited "$@" ;;
        *)
            echo "usage: ,agent-state <list|visited BLOCK>" >&2
            return 2
            ;;
    esac
}

main "$@"
