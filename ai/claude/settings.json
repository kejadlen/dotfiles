{
  "env": {
    "AI_AGENT": "claude",
    "DISABLE_AUTOUPDATER": "1",
    "PLAYWRIGHT_MCP_BROWSER": "webkit"
  },
  "permissions": {
    "allow": [
      "Bash(gh issue view:*)",
      "Bash(gh project field-list:*)",
      "Bash(gh project issue view:*)",
      "Bash(gh project item-list:*)",
      "Bash(gh project view:*)",
      "Bash(jj diff:*)",
      "Bash(jj log:*)",
      "Bash(jj show:*)",
      "Bash(jj status:*)",
      "Bash(jj workspace update-stale:*)",
      "mcp__dash-api__list_installed_docsets",
      "mcp__dash-api__search_documentation",
      "mcp__plugin_episodic-memory_episodic-memory__read",
      "mcp__plugin_episodic-memory_episodic-memory__search",
      "Skill(describing-changes)",
      "Skill(elements-of-style:writing-clearly-and-concisely)",
      "Skill(commit)",
      "Skill(superpowers:brainstorming)"
    ]
  },
  "model": "opus",
  "enabledMcpjsonServers": [
    "episodic-memory"
  ],
  "disableClaudeAiConnectors": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/no-git.sh"
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/agent-state.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/agent-state.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/agent-state.sh"
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/agent-state.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/agent-state.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/agent-state.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/agent-state.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "claude-md-management@claude-plugins-official": true,
    "learning-opportunities@learning-opportunities": true,
    "playground@claude-plugins-official": true,
    "ranger@ranger": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "superpowers-developing-for-claude-code@superpowers-marketplace": true,
    "typescript-lsp@claude-plugins-official": true,
    "learning-opportunities-auto@learning-opportunities": true
  },
  "extraKnownMarketplaces": {
    "ranger": {
      "source": {
        "source": "github",
        "repo": "kejadlen/ranger"
      }
    }
  },
  "effortLevel": "high",
  "agentPushNotifEnabled": true
}
