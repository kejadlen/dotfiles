{
  "env": {
    "AI_AGENT": "claude",
    "DISABLE_AUTOUPDATER": "1",
    "PLAYWRIGHT_MCP_BROWSER": "webkit"
  },
  "permissions": {
    "allow": [
      "Skill(skill:commit)",
      "Skill(skill:describing-changes)",
      "Skill(skill:design-notes)",
      "Skill(skill:jj)",
      "Skill(skill:ranger:ranger)",
      "Skill(skill:technical-writing)",
      "Skill(skill:til)"
    ],
    "deny": [
      "Read(**/.envrc)",
      "Read(//**/.envrc)"
    ],
    "defaultMode": "acceptEdits",
    "disableAutoMode": "disable"
  },
  "model": "opus",
  "enabledMcpjsonServers": [
    "episodic-memory"
  ],
  "disableClaudeAiConnectors": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/no-git.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/no-envrc.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/no-sops.sh"
          }
        ]
      }
    ]
  },
  "disableRemoteControl": true,
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "ranger@ranger": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "superpowers-developing-for-claude-code@superpowers-marketplace": true,
    "typescript-lsp@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "hegel-skill@hegeldev": true
  },
  "extraKnownMarketplaces": {
    "ranger": {
      "source": {
        "source": "github",
        "repo": "kejadlen/ranger"
      }
    },
    "hegeldev": {
      "source": {
        "source": "github",
        "repo": "hegeldev/hegel-skill"
      }
    }
  },
  "outputStyle": "bars",
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "agentPushNotifEnabled": true
}
